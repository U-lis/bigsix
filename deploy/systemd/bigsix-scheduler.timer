# bigsix-scheduler.service 를 매 분 부르는 timer (ADR-32).
#
# OnCalendar=*:0/1 — 매 시각의 0/1/2/... 분마다. AccuracySec=15s 는 정밀도 여유,
# Persistent=false — 서버가 꺼져 있던 동안의 tick 을 몰아서 돌리지 않는다 (그럴
# 필요가 없다, 매 분 tick 이라 최신 상태만 있으면 된다).
[Unit]
Description=bigsix push scheduler every minute

[Timer]
OnCalendar=*:0/1
AccuracySec=15s
Persistent=false
Unit=bigsix-scheduler.service

[Install]
WantedBy=timers.target
